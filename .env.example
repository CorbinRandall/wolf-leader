# Copy to .env and edit for your environment:
#   cp .env.example .env
#
# Wolf Leader — AI Project Storage (Postgres + pgvector edition)
# Env vars use IDE_STORAGE_* prefix for backward compatibility with existing installs.

# --- Required: how clients reach the hub ---
# wolf.local is published over mDNS by the hub LXC (see docs/lxc-hub.md); otherwise use http://<hub-ip>:6971.
IDE_STORAGE_PUBLIC_URL=http://wolf.local:6971
IDE_STORAGE_MCP_URL=http://wolf.local:6972/mcp

# Optional label inserted into pickup prompts ("Continue Foo on myserver …")
IDE_STORAGE_HOST_LABEL=wolf-leader

# Local time zone for anything a human reads (vault notes, wiki, summaries).
# Storage stays UTC. Display format is HH:MM MM/DD/YYYY.
WOLF_TZ=America/Chicago

# --- Database (docker-compose.postgres.yml wires DATABASE_URL automatically) ---
POSTGRES_USER=wolf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wolf_leader
# For running outside compose (tests, scripts):
# DATABASE_URL=postgresql://wolf:change-me@127.0.0.1:5432/wolf_leader

# --- Storage: two local disks on the hub machine (scripts/wolf-lxc-storage.sh sets them up) ---
# Postgres only, never shared (Postgres must own its files).
WOLF_PGDATA=/var/lib/wolf-postgres
# The drive every client maps: project repos, wolf-leader/vault (Obsidian), wolf-leader/hub (backups).
WOLF_SHARE_ROOT=/srv/wolf
IDE_STORAGE_SHARE_ROOT=/srv/wolf
IDE_STORAGE_VAULT_DIR=/srv/wolf/wolf-leader/vault
# How clients spell the same drive (path alias rewriting)
IDE_STORAGE_SHARE_WINDOWS=W:\
IDE_STORAGE_SHARE_UNC=\\wolf.local\wolf
IDE_STORAGE_SHARE_MAC=/Volumes/wolf
# Samba account clients use to map the drive (set by the storage script)
# WOLF_SHARE_USER=wolf
# WOLF_SHARE_PASSWORD=

# --- Paths (container defaults work for portable installs) ---
IDE_STORAGE_PROJECTS_DIR=/data/projects
IDE_STORAGE_COMPOSE_PATH=/app
IDE_STORAGE_CONTAINER=wolf-leader

# --- Cursor transcript import (optional) ---
# CURSOR_TRANSCRIPTS_ROOT=/home/you/.cursor/projects/your-workspace/agent-transcripts

# --- Compose auto-discovery (optional) ---
# COMPOSE_MANAGER_ROOT=/path/to/compose/projects

# --- Service ports ---
PORT=6971
MCP_PORT=6972
HOST=0.0.0.0
MCP_HOST=0.0.0.0
LOG_LEVEL=info

# --- Semantic (vector) search: ON by default, vectors live in pgvector ---
IDE_STORAGE_EMBEDDINGS_ENABLED=1
IDE_STORAGE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
FASTEMBED_CACHE_PATH=/opt/fastembed-cache

# --- Native wiki (Fumadocs + Halo) served at /wiki; rebuilt after saves/howls ---
WOLF_WIKI_ENABLED=1
# WOLF_WIKI_BUILD_TIMEOUT=900

# --- Connectors (optional; Phase 5) — JSON map name -> {type, url} ---
# Types: ollama (model_pull, model_list), http (probe). Model host lives in a *different* LXC/VM.
# WOLF_CONNECTORS={"models": {"type": "ollama", "url": "http://<models-host>:11434"}, "homepage": {"type": "http", "url": "http://<service-host>/"}}
