# Local configuration - never commit secrets or host-specific URLs
.env
.env.bak
.env.local
.env.*.local
docker-compose.local.yml

# Runtime data - your homelab memory stays private
data/ide-work.db
data/ide-work.db-*
data/logs/
data/*.pid
data/deployment-mcp.db
data/transcript*.jsonl
data/this_chat.json
data/INDEX.md
data/AGENTS.md
data/ONBOARDING.md
data/IDE_CLIENT_SETUP.md
data/SAVE_PROJECT.md
data/*.py

# Personal projects (keep only the shipped example template)
data/projects/*
!data/projects/_example/
!data/projects/_example/**

# Wiki (Fumadocs) - generated content + build output
wiki/node_modules/
wiki/.next/
wiki/out/
wiki/content/docs/**
!wiki/content/docs/index.md
wiki/.source/
wiki/next-env.d.ts
wiki/*.tsbuildinfo

